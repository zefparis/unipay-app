# UniPay App — Environment Variables
#
# These MUST be configured in the Vercel project settings for production.

# ─── Required (existing) ────────────────────────────────────────────

# Backend API URL (unipay-api on Render)
API_URL=https://unipay-api.onrender.com

# ─── Sensitive Session (now handled by unipay-api) ──────────────────
#
# Sensitive session state (blur/focus invalidation + PIN re-authentication)
# is now managed entirely by unipay-api via the wallet_sensitive_sessions
# table. No hybrid-vector-api dependency is required for the security
# decision.
#
# The following variables are NO LONGER REQUIRED and can be removed from
# Vercel project settings:
#   HYBRID_VECTOR_API_URL  (unused)
#   HCS_WORKER_SHARED_SECRET  (unused)

# ─── Optional ───────────────────────────────────────────────────────

# Node environment
NODE_ENV=production
