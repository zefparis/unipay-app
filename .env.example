# UniPay App — Environment Variables
#
# These MUST be configured in the Vercel project settings for production.

# ─── Required (existing) ────────────────────────────────────────────

# Backend API URL (unipay-api on Render)
API_URL=https://unipay-api.onrender.com

# ─── Required for Sensitive Session (new) ───────────────────────────

# Hybrid Vector API URL (for sensitive session endpoints)
# Default: https://hybrid-vector-api-owc4.onrender.com
HYBRID_VECTOR_API_URL=https://hybrid-vector-api-owc4.onrender.com

# Worker shared secret for hybrid-vector-api authentication
# Must match the HCS_WORKER_SHARED_SECRET in hybrid-vector-api's Render env vars
HCS_WORKER_SHARED_SECRET=

# ─── Optional ───────────────────────────────────────────────────────

# Node environment
NODE_ENV=production
